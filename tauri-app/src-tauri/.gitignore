# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Running `cargo test` inside a vendored plugin builds it as its own crate rather
# than as part of the app, leaving a target dir and a lockfile behind. Neither
# belongs here -- the app's own Cargo.lock is what governs these path deps.
plugins/*/target/
plugins/*/Cargo.lock
